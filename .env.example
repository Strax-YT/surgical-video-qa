# Backend: "stub" runs the whole pipeline with fake models (no GPU, no downloads).
# "real" loads YOLO / SAM / Whisper for actual inference.
SVQA_BACKEND=stub

# --- vision ---
SVQA_DETECTOR_WEIGHTS=data/artifacts/yolov8n-surgical.pt
SVQA_SEGMENTER_VARIANT=mobile_sam          # sam | sam2 | mobile_sam | fast_sam
SVQA_DEVICE=auto                            # auto | cpu | cuda
SVQA_MODEL_CACHE_SIZE=2                     # how many models stay resident

# --- neo4j ---
SVQA_NEO4J_URI=bolt://localhost:7687
SVQA_NEO4J_USER=neo4j
SVQA_NEO4J_PASSWORD=changeme-local-only

# --- vector store ---
SVQA_CHROMA_PATH=data/artifacts/chroma
SVQA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- llm ---
SVQA_GEMINI_API_KEY=
SVQA_LLM_MODEL=gemini-1.5-flash
